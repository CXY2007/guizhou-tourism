# 复制为 .env 后填写；.env 不提交
# 留空即可：应用首次启动会自动生成本机专属会话密钥
SECRET_KEY=
# 默认使用随包的脱敏 SQLite 数据库；需要 MySQL 时再填写自己的连接串
DATABASE_URL=sqlite:///instance/guizhou.db
SITE_PORT=8900

# 站点 AI（DeepSeek 函数调用；key 留空时走规则兜底）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT=15
AI_RATE_LIMIT=20

# 外部服务
AMAP_WEB_KEY=
AMAP_JS_KEY=
AMAP_SECURITY_CODE=
HEFENG_KEY=
HEFENG_HOST=

# 小红书 cookie（AI 行程规划参考笔记用；可留空）
XHS_COOKIE=
